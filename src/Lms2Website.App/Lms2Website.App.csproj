<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LMS2Website</AssemblyName>
    <RootNamespace>Lms2Website.App</RootNamespace>
    <!-- Declares PerMonitorV2; without it the app is not DPI aware and WACK warns. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lms2Website.Core\Lms2Website.Core.csproj" />
  </ItemGroup>

</Project>
