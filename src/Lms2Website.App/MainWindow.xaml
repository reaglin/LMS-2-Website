<Window x:Class="Lms2Website.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lms2Website.App.ViewModels"
        Title="LMS 2 Website" Height="820" Width="1000" MinHeight="560" MinWidth="720"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Show" />

    <HierarchicalDataTemplate DataType="{x:Type vm:PreviewNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanInclude}"
                  IsThreeState="False" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Title}" FontWeight="{Binding IsSection, Converter={StaticResource BoldIfSection}}" />
        <TextBlock Text="{Binding Detail}" Margin="10,0,0,0" Foreground="{StaticResource TextSoft}" FontSize="11"
                   VerticalAlignment="Center" />
      </StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid>
    <DockPanel>

      <!-- header -->
      <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              Padding="20,12">
        <Grid>
          <StackPanel>
            <TextBlock Text="LMS 2 Website" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Turn a course export into a website, and put it on GitHub Pages."
                       Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
          <!-- Both always reachable: step 3 is disabled until a site is built, and the help is
               most wanted before that, not after. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="What is a course export?" Click="OnCartridgeHelp" />
            <Button Content="New to GitHub?" Margin="8,0,0,0" Click="OnHelp" />
            <Button Content="GitHub token…" Margin="8,0,0,0" Click="OnSettings" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- busy strip -->
      <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
              Padding="20,10" Visibility="{Binding IsBusy, Converter={StaticResource Show}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding BusyMessage}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         Foreground="{StaticResource Accent}" BorderThickness="0" Background="#E6E9EE" />
          </StackPanel>
          <Button Grid.Column="1" Content="Cancel" Margin="16,0,0,0" Command="{Binding CancelCommand}" />
        </Grid>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="860">

          <!-- ── your courses ─────────────────────────────────────────── -->
          <Border Style="{StaticResource CardBorder}"
                  Visibility="{Binding HasCourses, Converter={StaticResource Show}}">
            <StackPanel>
              <Expander IsExpanded="True">
                <Expander.Header>
                  <TextBlock Text="Your courses" FontWeight="SemiBold" FontSize="14" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Courses}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <!-- Each label travels with its value, so a wrap never orphans one. -->
                            <WrapPanel Margin="0,4,0,0">
                              <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                <TextBlock Text="Export:" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Hint}" Margin="4,0,0,0"
                                           Foreground="{Binding Source, Converter={StaticResource StateColour}}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                <TextBlock Text="Converted:" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding ConvertedText}" Style="{StaticResource Hint}" Margin="4,0,0,0"
                                           Foreground="{Binding Converted, Converter={StaticResource StateColour}}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                <TextBlock Text="Website:" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding SiteText}" Style="{StaticResource Hint}" Margin="4,0,0,0"
                                           Foreground="{Binding Site, Converter={StaticResource StateColour}}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Pushed:" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding PushedText}" Style="{StaticResource Hint}" Margin="4,0,0,0"
                                           Foreground="{Binding Pushed, Converter={StaticResource StateColour}}" />
                              </StackPanel>
                            </WrapPanel>
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open" Padding="10,3" Click="OnOpenCourse" Tag="{Binding}" />
                            <Button Content="Folder" Padding="10,3" Margin="6,0,0,0" Click="OnOpenCourseFolder"
                                    Tag="{Binding}" IsEnabled="{Binding SiteExists}" />
                            <Button Content="Website" Padding="10,3" Margin="6,0,0,0" Click="OnOpenCourseSite"
                                    Tag="{Binding}" IsEnabled="{Binding CanOpenSite}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="Read from this computer only. &quot;Pushed&quot; means the site was sent to GitHub — it does not mean the site is reachable. To know that, check GitHub Pages for the repository (Settings → Pages), or open the website." />
            </StackPanel>
          </Border>

          <!-- ── 1. the export ─────────────────────────────────────────── -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepNumber}">
                  <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Choose the LMS export" Style="{StaticResource StepTitle}" />
              </StackPanel>

              <Grid Margin="34,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True"
                         Background="#FAFBFC" Foreground="{StaticResource TextSoft}" />
                <Button Grid.Column="1" Content="Choose…" Margin="8,0,0,0" Command="{Binding ChooseSourceCommand}" />
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Margin="34,6,0,0"
                         Text="An .imscc file exported from Brightspace, Canvas, Moodle or Blackboard — or drop one on this window." />

              <StackPanel Margin="34,12,0,0" Visibility="{Binding HasCourse, Converter={StaticResource Show}}">
                <TextBlock Text="Course title" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding CourseTitle, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding CourseSummary}" Margin="0,8,0,0" Foreground="{StaticResource TextSoft}" />

                <Expander Header="What the website will contain" Margin="0,12,0,0" IsExpanded="True">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                    <TreeView ItemsSource="{Binding Preview}" MaxHeight="300" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                      <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                        </Style>
                      </TreeView.ItemContainerStyle>
                    </TreeView>
                  </Border>
                </Expander>

                <TextBlock Text="{Binding ReadWarnings}" Foreground="{StaticResource Warn}" Margin="0,10,0,0"
                           Visibility="{Binding ReadWarnings, Converter={StaticResource ShowIfText}}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ── 2. the website ────────────────────────────────────────── -->
          <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding HasCourse}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepNumber}">
                  <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Build the website" Style="{StaticResource StepTitle}" />
              </StackPanel>

              <Grid Margin="34,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Command="{Binding ChooseOutputCommand}" />
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Margin="34,6,0,0"
                         Text="The folder is emptied and rebuilt each time (a .git folder inside it is kept)." />

              <CheckBox Content="Leave some files out of the publish" IsChecked="{Binding ExcludeFiles}"
                        Margin="34,12,0,0" Foreground="{StaticResource TextSoft}" />
              <StackPanel Margin="52,6,0,0"
                          Visibility="{Binding ExcludeFiles, Converter={StaticResource Show}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Bigger than" VerticalAlignment="Center" Foreground="{StaticResource TextSoft}" />
                  <TextBox Text="{Binding ExcludeOverMb, UpdateSourceTrigger=PropertyChanged}"
                           Width="56" Margin="8,0,0,0" />
                  <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"
                             Foreground="{StaticResource TextSoft}" />
                  <TextBlock Text="Types" VerticalAlignment="Center" Margin="20,0,0,0"
                             Foreground="{StaticResource TextSoft}" />
                  <TextBox Text="{Binding ExcludeTypes, UpdateSourceTrigger=PropertyChanged}"
                           Width="180" Margin="8,0,0,0" ToolTip=".pptx, .zip, .mp4 — commas or spaces" />
                </StackPanel>
                <CheckBox Content="Quizzes — they contain the answers" IsChecked="{Binding ExcludeQuizzes}"
                          Margin="0,8,0,0" Foreground="{StaticResource TextSoft}"
                          ToolTip="A quiz is left out of the website altogether, not merely kept out of the push." />
                <TextBlock Text="{Binding ExcludeSummary, Mode=OneWay}" Style="{StaticResource Hint}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ExcludeSummary, Converter={StaticResource ShowIfText}}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="34,12,0,0">
                <Button Content="Build website" Style="{StaticResource PrimaryButton}" Command="{Binding BuildCommand}" />
                <Button Content="Open in browser" Margin="8,0,0,0" Command="{Binding OpenSiteCommand}" />
                <Button Content="Open folder" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
              </StackPanel>

              <TextBlock Text="{Binding BuildResult}" Margin="34,10,0,0" Foreground="{StaticResource Good}"
                         Visibility="{Binding BuildResult, Converter={StaticResource ShowIfText}}" />
              <Expander Header="Notes from the conversion" Margin="34,8,0,0"
                        Visibility="{Binding BuildWarnings, Converter={StaticResource ShowIfText}}">
                <TextBox Text="{Binding BuildWarnings, Mode=OneWay}" IsReadOnly="True" MaxHeight="200"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FAFBFC"
                         Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </Expander>
            </StackPanel>
          </Border>

          <!-- ── 3. GitHub ─────────────────────────────────────────────── -->
          <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding SiteBuilt}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepNumber}">
                  <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Publish to GitHub Pages" Style="{StaticResource StepTitle}" />
              </StackPanel>

              <TextBlock Style="{StaticResource Hint}" Margin="34,8,0,0" TextWrapping="Wrap"
                         Text="This copies the finished website to GitHub, which stores and serves it for free, and gives you a web address anyone can open. You need a free GitHub account, and permission to publish into whichever account you name below. The repository must be public for anyone to see the site." />

              <TextBlock Text="{Binding TokenStatus}" Style="{StaticResource Hint}" Margin="34,8,0,0" />

              <Grid Margin="34,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.2*" />
                  <ColumnDefinition Width="1.6*" />
                  <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="GitHub account" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />

                <TextBlock Grid.Column="1" Text="Repository" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Repository, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />

                <TextBlock Grid.Column="2" Text="Branch" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>

              <TextBlock Text="{Binding PublishTarget, Mode=OneWay}" Style="{StaticResource Hint}"
                         TextWrapping="Wrap" Margin="34,6,0,0"
                         Visibility="{Binding PublishTarget, Converter={StaticResource ShowIfText}}" />

              <CheckBox Content="Private repository" IsChecked="{Binding IsPrivate}"
                        Margin="34,10,0,0" Foreground="{StaticResource TextSoft}" />
              <Border Margin="52,6,0,0" Padding="10,8" CornerRadius="6" Background="#FFF6E5"
                      BorderBrush="{StaticResource Warn}" BorderThickness="1,0,0,0"
                      Visibility="{Binding PrivateWarning, Converter={StaticResource ShowIfText}}">
                <TextBlock Text="{Binding PrivateWarning, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{StaticResource Warn}" FontSize="12" />
              </Border>

              <StackPanel Orientation="Horizontal" Margin="34,12,0,0">
                <Button Content="Publish" Style="{StaticResource PrimaryButton}" Command="{Binding PublishCommand}" />
                <Button Content="Open the site" Margin="8,0,0,0" Command="{Binding OpenPagesCommand}" />
              </StackPanel>

              <TextBlock Margin="34,12,0,0" Visibility="{Binding PagesUrl, Converter={StaticResource ShowIfText}}">
                <Run Text="Address:" Foreground="{StaticResource TextSoft}" />
                <Hyperlink NavigateUri="{Binding PagesUrl}" RequestNavigate="OnNavigate">
                  <Run Text="{Binding PagesUrl, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
              <TextBlock Text="{Binding NextSteps}" Margin="34,8,0,0" Foreground="{StaticResource Warn}"
                         Visibility="{Binding NextSteps, Converter={StaticResource ShowIfText}}" />

              <Expander Header="Details" Margin="34,10,0,0"
                        Visibility="{Binding PublishLog, Converter={StaticResource ShowIfText}}">
                <TextBox Text="{Binding PublishLog, Mode=OneWay}" IsReadOnly="True" MaxHeight="220" Margin="0,6,0,0"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         BorderThickness="0" Background="#FAFBFC" Foreground="{StaticResource TextSoft}" />
              </Expander>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
