<Window x:Class="Lms2Website.App.Views.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub token" Height="440" Width="560" ResizeMode="NoResize"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterOwner">

  <Border Style="{StaticResource CardBorder}" Margin="16">
    <StackPanel>
      <TextBlock Text="Publish without leaving the app" FontSize="15" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="With a personal access token the app can create the repository, push the website and switch GitHub Pages on. Without one it falls back to Git on this machine, and you switch Pages on yourself." />

      <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}" FontSize="12">
        <Run Text="Make a fine-grained token at" />
        <Hyperlink NavigateUri="https://github.com/settings/personal-access-tokens/new" RequestNavigate="OnNavigate">
          github.com/settings/personal-access-tokens
        </Hyperlink>
        <LineBreak />
        <Run Text="Repository access: all repositories (or just the one). Permissions: Administration (read and write, to create the repository), Contents (read and write), Pages (read and write)." />
      </TextBlock>

      <TextBlock Text="Token" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
      <PasswordBox x:Name="TokenBox" Padding="6,5" />
      <TextBlock x:Name="Status" Style="{StaticResource Hint}" Margin="0,8,0,0" />

      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="Check and save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        <Button Content="Remove" Margin="8,0,0,0" Click="OnRemove" />
        <Button Content="Close" Margin="8,0,0,0" Click="OnClose" />
      </StackPanel>

      <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0" TextWrapping="Wrap"
                 Text="The token is encrypted for your Windows account and kept in Documents\LMS 2 Website. It never travels with a course or a website." />
    </StackPanel>
  </Border>
</Window>
